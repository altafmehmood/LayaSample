{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Laya": {
    "CacheDirectory": "../../models"
  },
  "DocumentAnalysis": {
    "MaxFileBytes": 20971520,
    "MinCharsPerPage": 50,
    "PngDpi": 150,
    "MaxPages": 20
  },
  "Extraction": {
    "Provider": "openai",
    "VisionModel": "gpt-6.1-sol",
    "TextModel": "gpt-6-luna",
    "Pricing": {
      "AsOf": "2026-10-11",
      "Models": {
        "gpt-6.1-sol": {
          "Tiers": [
            { "MaxInputTokens": 272000, "InputPerMillion": 2.00, "CachedInputPerMillion": 0.10, "OutputPerMillion": 10.00 },
            { "InputPerMillion": 4.00, "CachedInputPerMillion": 0.20, "OutputPerMillion": 15.00 }
          ]
        },
        "gpt-6-luna": {
          "Tiers": [
            { "MaxInputTokens": 272000, "InputPerMillion": 0.10, "CachedInputPerMillion": 0.01, "OutputPerMillion": 0.50 },
            { "InputPerMillion": 0.20, "CachedInputPerMillion": 0.02, "OutputPerMillion": 0.75 }
          ]
        }
      }
    }
  },
  "Usage": {
    "DatabasePath": "data/usage.db"
  },
  "Security": {
    "Malware": {
      "Provider": "clamd",
      "Host": "clamav",
      "Port": 3310,
      "TimeoutSeconds": 60,
      "FailMode": "closed"
    }
  },
  "AllowedHosts": "*"
}
