{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DocumentAnalysis": {
    "MaxFileBytes": 20971520,
    "MinCharsPerPage": 50,
    "PngDpi": 150,
    "MaxPages": 20
  },
  "Usage": {
    "DatabasePath": "data/usage.db"
  },
  "Security": {
    "Malware": {
      "Provider": "scan-service",
      "ServiceUrl": "",
      "TimeoutSeconds": 60,
      "FailMode": "closed"
    }
  },
  "AllowedHosts": "*"
}
