<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Laya, the local decision model that scores hotel-guest feedback. It runs on ONNX Runtime, takes a few minutes to load
    and about a gigabyte of memory, and needs no network once the model is on disk, so it has a service of its own: the
    gateway starts in seconds and a slow or failed model load never holds it back.
  -->

  <PropertyGroup>
    <!-- Development secrets (dotnet user-secrets): the telemetry settings, if exported from a local run. Never read in Production. -->
    <UserSecretsId>a86fc2f5-7323-4c2e-b86c-b8cb20657ad9</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ElBruno.LocalLLMs.Decisions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DocIntake.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DocIntake.Contracts\DocIntake.Contracts.csproj" />
    <ProjectReference Include="..\DocIntake.ServiceDefaults\DocIntake.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
