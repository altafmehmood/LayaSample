{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Laya": {
    "CacheDirectory": "../../models"
  },
  "DocumentAnalysis": {
    "MaxFileBytes": 20971520,
    "MinCharsPerPage": 50,
    "PngDpi": 150,
    "MaxPages": 20
  },
  "Extraction": {
    "Provider": "openai",
    "VisionModel": "gpt-5.4-mini",
    "TextModel": "gpt-5.4-mini"
  },
  "AllowedHosts": "*"
}
