{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "api", "renderer", "gateway"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["registry", "tag"],
      "properties": {
        "registry": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1, "not": { "const": "latest" }, "description": "Pin a sha-<commit> tag." },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "api": {
      "type": "object",
      "properties": {
        "replicas": { "type": "integer", "minimum": 0 },
        "config": {
          "type": "object",
          "properties": {
            "maxConcurrentAnalyses": { "type": "integer", "minimum": 0 },
            "maxQueuedAnalyses": { "type": "integer", "minimum": 0 },
            "requestTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
            "maxFileBytes": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "renderer": {
      "type": "object",
      "properties": {
        "replicas": { "type": "integer", "minimum": 0 },
        "config": {
          "type": "object",
          "properties": {
            "maxConcurrentJobs": { "type": "integer", "minimum": 0 },
            "maxQueuedJobs": { "type": "integer", "minimum": 0 },
            "ocrModel": { "enum": ["", "PPOCRv5Latin", "PPOCRv6Tiny", "PPOCRv6Small", "PPOCRv6Medium"] }
          }
        }
      }
    },
    "gateway": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "hostname": { "type": "string" },
        "create": { "type": "boolean" },
        "requestTimeout": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" }
      },
      "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
      "then": { "properties": { "hostname": { "minLength": 1 } }, "required": ["hostname"] }
    }
  }
}
