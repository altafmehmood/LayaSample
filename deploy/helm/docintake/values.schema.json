{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "api",
    "renderer",
    "extraction",
    "gateway"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": [
        "registry",
        "tag"
      ],
      "properties": {
        "registry": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "not": {
            "const": "latest"
          },
          "description": "Pin a sha-<commit> tag."
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "api": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "config": {
          "type": "object",
          "properties": {
            "maxConcurrentAnalyses": {
              "type": "integer",
              "minimum": 0
            },
            "maxQueuedAnalyses": {
              "type": "integer",
              "minimum": 0
            },
            "requestTimeoutSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            },
            "maxFileBytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "auth": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "secretKeys": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "maxItems": 4
            },
            "keyChecksum": {
              "type": "string"
            },
            "adminSecretKeys": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "maxItems": 4
            }
          }
        },
        "usage": {
          "type": "object",
          "properties": {
            "persistence": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "size": {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti)$"
                },
                "storageClass": {
                  "type": "string"
                },
                "accessMode": {
                  "enum": [
                    "ReadWriteOnce",
                    "ReadWriteOncePod"
                  ]
                },
                "existingClaim": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "renderer": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "config": {
          "type": "object",
          "properties": {
            "maxConcurrentJobs": {
              "type": "integer",
              "minimum": 0
            },
            "maxQueuedJobs": {
              "type": "integer",
              "minimum": 0
            },
            "ocrModel": {
              "enum": [
                "",
                "PPOCRv5Latin",
                "PPOCRv6Tiny",
                "PPOCRv6Small",
                "PPOCRv6Medium"
              ]
            }
          }
        }
      }
    },
    "extraction": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "secretKey": {
          "type": "string",
          "minLength": 1
        },
        "keyChecksum": {
          "type": "string"
        },
        "provider": {
          "enum": [
            "openai"
          ]
        },
        "visionModel": {
          "type": "string",
          "minLength": 1
        },
        "textModel": {
          "type": "string",
          "minLength": 1
        },
        "maxConcurrent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 600
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "endpoint": {
          "type": "string",
          "pattern": "^(https?://.+)?$"
        },
        "existingSecret": {
          "type": "string"
        },
        "headersKey": {
          "type": "string",
          "minLength": 1
        },
        "headersChecksum": {
          "type": "string"
        },
        "collector": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1,
              "not": {
                "const": "latest"
              }
            },
            "headerName": {
              "type": "string",
              "minLength": 1
            },
            "apiKeyKey": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "gateway": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hostname": {
          "type": "string"
        },
        "create": {
          "type": "boolean"
        },
        "requestTimeout": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h)$"
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        },
        "required": [
          "enabled"
        ]
      },
      "then": {
        "properties": {
          "hostname": {
            "minLength": 1
          }
        },
        "required": [
          "hostname"
        ]
      }
    },
    "malware": {
      "type": "object",
      "properties": {
        "clamd": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "failMode": {
              "enum": [
                "closed",
                "open"
              ]
            }
          }
        }
      }
    }
  }
}
