<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- xunit v3 test projects are self-hosting executables (Microsoft.Testing.Platform). -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LayaSample.Api\LayaSample.Api.csproj" />
    <ProjectReference Include="..\..\src\LayaSample.Renderer\LayaSample.Renderer.csproj" />
    <!-- Direct, so RapidOcrNet's build targets (which copy the bundled OCR models) reach this project too. -->
    <ProjectReference Include="..\..\src\LayaSample.Rendering\LayaSample.Rendering.csproj" />
  </ItemGroup>

</Project>
