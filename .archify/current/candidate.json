  "cards": [
    { "dot": "cyan", "title": "Request Path", "items": [
      "Gateway terminates HTTPS and forwards /laya to the API (httproute.yaml:26)",
      "The API key is checked before the extract handler runs (Program.cs:340)",
      "The model receives page images with each page's OCR text (ExtractionMessageBuilder.cs:43-54)" ] },
    { "dot": "rose", "title": "Trust Boundaries", "items": [
      "Every upload is streamed to ClamAV before any parser reads it; an infection is refused with 422 (DocumentPipeline.cs:50-56)",
      "PDFium and ImageMagick run only in the renderer (LocalPageRasterizer.cs:135-141)",
      "PdfPig, ClosedXML and OpenXML parse untrusted files inside the API process (DocumentClassifier.cs:69, DocumentPreparer.cs:276-283)",
      "Renderer egress is limited to the collector and DNS (networkpolicy.yaml:24-47)" ] },
    { "dot": "emerald", "title": "Usage and Telemetry", "items": [
      "Each model call is queued and written to a SQLite file; GET /api/usage serves it as JSON or CSV (UsageStore.cs:19, UsageEndpoints.cs:75)",
      "The collector alone holds the Honeycomb ingest key (collector-config.yaml:24)",
      "Production is not yet verified: the collector image and Honeycomb ingestion are untested" ] },
    { "dot": "amber", "title": "Not Shown", "items": [
      "Local dotnet run turns scanning off in appsettings.Development.json; Compose and Helm turn it on",
      "The analyze route dispatches to stub agents, not real downstream agents (Program.cs:215)",
      "The manual garak red-team harness and its CI job are not part of the runtime (redteam/)" ] }
  ]
