  "cards": [
    {
      "dot": "cyan",
      "title": "Request Path",
      "items": [
        "Gateway terminates HTTPS and forwards /laya to the API (httproute.yaml:26)",
        "API key is checked before the extract handler runs (Program.cs:163, 331)",
        "Model receives page images with each page's OCR text (ExtractionMessageBuilder.cs:42-51)"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust Boundaries",
      "items": [
        "PDFium and ImageMagick run only in the renderer (LocalPageRasterizer.cs:131-140)",
        "PdfPig, ClosedXML and OpenXML parse untrusted files inside the API process (DocumentClassifier.cs:69, DocumentPreparer.cs:261-282)",
        "Renderer egress is limited to the collector and DNS (networkpolicy.yaml:24-47)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Telemetry",
      "items": [
        "The collector alone holds the Honeycomb ingest key (collector-config.yaml:24)",
        "API and renderer send OTLP to the in-cluster collector (values-prod.yaml)",
        "Production is not yet verified: the collector image and Honeycomb ingestion are untested"
      ]
    },
    {
      "dot": "amber",
      "title": "Not Shown",
      "items": [
        "The analyze route dispatches to stub agents, not real downstream agents (Program.cs:78)",
        "Honeycomb dashboards and alerts are not configured by this repository"
      ]
    }
  ]
