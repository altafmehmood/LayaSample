# Manual tests for POST /api/documents/analyze. See README.md for the expected result of each.
# dispatch=false skips the agent; remove it to see the stub agent's response.

@host = http://localhost:5091

### Text PDF -> Markdown
POST {{host}}/api/documents/analyze?dispatch=false
Content-Type: multipart/form-data; boundary=sample

--sample
Content-Disposition: form-data; name="file"; filename="text.pdf"
Content-Type: application/pdf

< ./pdf/text.pdf
--sample--

### Scanned PDF with text -> page image + OCR
POST {{host}}/api/documents/analyze?dispatch=false
Content-Type: multipart/form-data; boundary=sample

--sample
Content-Disposition: form-data; name="file"; filename="scanned-ocr.pdf"
Content-Type: application/pdf

< ./pdf/scanned-ocr.pdf
--sample--

### Blank scan -> page image, no OCR text
POST {{host}}/api/documents/analyze?dispatch=false
Content-Type: multipart/form-data; boundary=sample

--sample
Content-Disposition: form-data; name="file"; filename="scanned-blank.pdf"
Content-Type: application/pdf

< ./pdf/scanned-blank.pdf
--sample--

